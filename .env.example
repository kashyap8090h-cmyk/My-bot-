# Binance API credentials. Keep these secret and never commit real keys.
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Use Binance testnet/sandbox when possible.
BINANCE_TESTNET=true

# Safety switch: keep false until you fully understand the strategy and risk.
LIVE_TRADING=false

# Gold exposure on Binance is commonly represented by PAXG/USDT.
SYMBOL=PAXGUSDT
INTERVAL=1m

# Risk settings
ACCOUNT_RISK_PERCENT=0.5
RISK_REWARD_RATIO=1.5
MAX_POSITION_USDT=50
DAILY_LOSS_LIMIT_USDT=10
STOP_LOSS_PERCENT=0.25

# Strategy settings
FAST_EMA=9
SLOW_EMA=21
RSI_PERIOD=14
RSI_BUY_MAX=65
RSI_SELL_MIN=35
POLL_SECONDS=15
